# Copy to .env.local. The NEXT_PUBLIC_ prefix means this is inlined into the
# CLIENT bundle at build time, so it must never hold a secret — only the public
# API base URL belongs here.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Razorpay's PUBLISHABLE key id (rzp_test_… / rzp_live_…). Public by design — it
# identifies the merchant to Razorpay's checkout and can do nothing on its own.
# The secret lives only on the backend as PAYMENT_KEY_SECRET and must never be
# given the NEXT_PUBLIC_ prefix, which inlines a value into the browser bundle.
#
# Leave blank for local work: with no gateway credentials the backend selects its
# mock gateway, and the client follows whatever provider the server reports.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
